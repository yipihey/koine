,{"schema":"INSPIRE BAI","value":"Monika.Bansal.1"}],"first_name":"Monika"},{"full_name":"Bansal, Sunil","last_name":"Bansal","ids":[{"schema":"INSPIRE ID","value":"INSPIRE-00307490"},{"schema":"CERN","value":"CERN-670645"},{"schema":"INSPIRE BAI","value":"S.Bansal.1"}],"first_name":"Sunil"},{"full_name":"Beaumont, Willem","last_name":"Beaumont","ids":[{"schema":"INSPIRE ID","value":"INSPIRE-00065357"},{"schema":"CERN","value":"CERN-472232"},{"schema":"INSPIRE BAI","value":"W.Beaumont.1"}],"first_name":"Willem"},{"full_name":"Cornelis, Tom","last_name":"Cornelis","ids":[{"schema":"INSPIRE ID","value":"INSPIRE-00334164"},{"schema":"CERN","value":"CERN-683438"},{"schema":"INSPIRE BAI","value":"T.Cornelis.2"}],"first_name":"Tom"},{"full_name":"De Wolf, Eddi A","last_name":"De Wolf","ids":[{"schema":"INSPIRE ID","value":"INSPIRE-00076245"},{"schema":"CERN","value":"CERN-386127"},{"schema":"INSPIRE BAI","value":"E.A.De.Wolf.1"}],"first_name":"Eddi A"},{"full_name":"Druzhkin, Dmitry","last_name":"Druzhkin","ids":[{"schema":"INSPIRE ID","value":"INSPIRE-00308619"},{"schema":"CERN","value":"CERN-600874"},{"schema":"INSPIRE BAI","value":"Dmitry.Druzhkin.1"}],"first_name":"Dmitry"},{"full_name":"Janssen, Xavier","last_name":"Janssen","ids":[{"schema":"INSPIRE ID","value":"INSPIRE-00054271"},{"schema":"CERN","value":"CERN-485055"},{"schema":"ORCID","value":"0000-0002-3998-4081"},{"schema":"INSPIRE BAI","value":"X.Janssen.1"}],"first_name":"Xavier"},{"full_name":"Luyckx, Sten","last_name":"Luyckx","ids":[{"schema":"INSPIRE ID","value":"INSPIRE-00293030"},{"schema":"CERN","value":"CERN-703371"},{"schema":"INSPIRE BAI","value":"S.Luyckx.1"}],"first_name":"Sten"},{"full_name":"Mucibello, Luca","last_name":"Mucibello","ids":[{"schema":"INSPIRE ID","value":"INSPIRE-00310788"},{"schema":"CERN","value":"CERN-667438"},{"schema":"INSPIRE BAI","value":"L.Mucibello.1"}],"first_name":"Luca"},{"full_name":"Ochesanu, Silvia","last_name":"Ochesanu","ids":[{"schema":"INSPIRE ID","value":"INSPIRE-00311060"},{"schema":"CERN","value":"CERN-640217"},{"schema":"INSPIRE BAI","value":"S.Ochesanu.1"}],"first_name":"Silvia"}],"citation_count":17127,"publication_info":[{"journal_volume":"716","page_end":"61","year":2012,"page_start":"30","journal_title":"Phys.Lett.B"}],"collaborations":[{"value":"CMS"}],"abstracts":[{"source":"Elsevier","value":"Results are presented from searches for the standard model Higgs boson in proton–proton collisions at s=7 and 8 TeV in the Compact Muon Solenoid experiment at the LHC, using data samples corresponding to integrated luminosities of up to 5.1 fb −1 at 7 TeV and 5.3 fb −1 at 8 TeV. The search is performed in five decay modes: γγ , ZZ, W+W− , τ+τ− , and bb¯ . An excess of events is observed above the expected background, with a local significance of 5.0 standard deviations, at a mass near 125 GeV, signalling the production of a new particle. The expected significance for a standard model Higgs boson of that mass is 5.8 standard deviations. The excess is most significant in the two decay modes with the best mass resolution, γγ and ZZ; a fit to these signals gives a mass of 125.3±0.4(stat.)±0.5(syst.) GeV . The decay to two photons indicates that the new particle is a boson with spin different from one.","abstract_source_suggest":{"input":"Elsevier"}},{"source":"arXiv","value":"Results are presented from searches for the standard model Higgs boson in proton-proton collisions at sqrt(s) = 7 and 8 TeV in the Compact Muon Solenoid experiment at the LHC, using data samples corresponding to integrated luminosities of up to 5.1 inverse femtobarns at 7 TeV and 5.3 inverse femtobarns at 8 TeV. The search is performed in five decay modes: gamma gamma, ZZ, WW, tau tau, and b b-bar. An excess of events is observed above the expected background, with a local significance of 5.0 standard deviations, at a mass near 125 GeV, signalling the production of a new particle. The expected significance for a standard model Higgs boson of that mass is 5.8 standard deviations. The excess is most significant in the two decay modes with the best mass resolution, gamma gamma and ZZ; a fit to these signals gives a mass of 125.3 +/- 0.4 (stat.) +/- 0.5 (syst.) GeV. The decay to two photons indicates that the new particle is a boson with spin different from one.","abstract_source_suggest":{"input":"arXiv"}}],"preprint_date":"2012-07","external_system_identifiers":[{"schema":"OSTI","value":"1419280"},{"schema":"HAL","value":"in2p3-00722244"},{"schema":"ADS","value":"2012PhLB..716...30C"},{"schema":"CDS","value":"1471016"},{"schema":"SPIRES","value":"SPIRES-9684190"}],"titles":[{"title":"Observation of a New Boson at a Mass of 125 GeV with the CMS Experiment at the LHC"},{"source":"arXiv","title":"Observation of a new boson at a mass of 125 GeV with the CMS experiment at the LHC"}],"control_number":1124338,"dois":[{"value":"10.1016/j.physletb.2012.08.021"}],"arxiv_eprints":[{"categories":["hep-ex"],"value":"1207.7235"}],"earliest_date":"2012-07","document_type":["article"]},"updated":"2026-08-01T14:14:32.448010+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1124338?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1124338?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1124338?format=latex-us","json":"https://inspirehep.net/api/literature/1124338?format=json","json-expanded":"https://inspirehep.net/api/literature/1124338?format=json-expanded","cv":"https://inspirehep.net/api/literature/1124338?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1124338"}}],"total":2},"links":{"self":"https://inspirehep.net/api/literature/?q=collaboration%20CMS%20and%20t%20%22observation%20of%20a%20new%20boson%22%20and%20date%202012&size=1&page=1&fields=control_number,titles,authors.full_name,authors.first_name,authors.last_name,authors.ids,earliest_date,preprint_date,publication_info,dois,arxiv_eprints,documents,abstracts,citation_count,document_type,extern